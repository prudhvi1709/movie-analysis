const pil=v=>v==="go"?'<span class="pill p-go">Release</span>':v==="ok"?'<span class="pill p-ok">Workable</span>':'<span class="pill p-no">Avoid</span>';
const tb=document.querySelector("#scoreTable tbody");
data.forEach(x=>{const tr=document.createElement("tr");if(x.v==="go")tr.className="win";
  tr.innerHTML=`<td><strong>${x.d}</strong></td><td>${pil(x.v)}</td><td>${x.c}</td><td>${x.r}</td><td>${x.h}</td><td>${x.s}</td><td>${x.e}</td><td class="score" style="color:${col(x.v)}">${x.total}</td><td><div class="bar-wrap"><div class="bar" style="width:${x.total}%;background:${col(x.v)}"></div></div></td>`;
  tb.appendChild(tr);});

new Chart(document.getElementById("scoreChart"),{type:"bar",
  data:{labels:data.map(x=>x.d),datasets:[{data:data.map(x=>x.total),backgroundColor:data.map(x=>col(x.v)),borderRadius:5,maxBarThickness:46}]},
  options:{plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>`Score: ${c.raw}/100`}}},
    scales:{y:{beginAtZero:true,max:100,grid:{color:"#282c36"},ticks:{color:"#98a1b0"},title:{display:true,text:"Weighted score /100",color:"#98a1b0"}},
            x:{grid:{display:false},ticks:{color:"#cdd3dd"}}}}});

const hours=["6a","8a","10a","12p","2p","4p","5p","6p","7p","8p","9p","10p","11p","12a"];
const act=[10,22,35,42,40,50,62,78,90,100,96,82,55,30];
new Chart(document.getElementById("hourChart"),{type:"line",
  data:{labels:hours,datasets:[{label:"Audience activity (IST)",data:act,borderColor:"#e0a92e",backgroundColor:"rgba(224,169,46,.15)",fill:true,tension:.4,pointRadius:0}]},
  options:{plugins:{legend:{labels:{color:"#cdd3dd"}}},scales:{y:{beginAtZero:true,max:110,grid:{color:"#282c36"},ticks:{color:"#98a1b0"}},x:{grid:{display:false},ticks:{color:"#98a1b0",maxRotation:0}}}}});

new Chart(document.getElementById("dayChart"),{type:"bar",
  data:{labels:["Mon","Tue","Wed","Thu","Fri","Sat","Sun"],datasets:[{label:"Engagement index",data:[78,95,100,84,88,72,70],backgroundColor:["#3a3f4a","#e0a92e","#e0a92e","#3a3f4a","#5b9cf5","#3a3f4a","#3a3f4a"],borderRadius:5}]},
  options:{plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,max:110,grid:{color:"#282c36"},ticks:{color:"#98a1b0"}},x:{grid:{display:false},ticks:{color:"#cdd3dd"}}}}});
</script>
</body>
</html>
